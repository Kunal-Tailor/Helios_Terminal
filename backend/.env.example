# =============================================================================
# Helios Terminal — environment variables
#
# Copy this file to .env and fill in your real values.
# .env is excluded from version control (.gitignore). Never commit real keys.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# Set LLM_PROVIDER to "gemini", "deepseek", or "openrouter" to switch active provider.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Google Gemini (OpenAI-compatible API via Google AI Studio) — Free personal tier
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# DeepSeek (OpenAI-compatible API) — Primary paid option
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenRouter (OpenAI-compatible API) — Alternative testing
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model identifier — e.g. "gemini-2.0-flash", "deepseek-chat", etc.
DEFAULT_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# Retrieval augmentation: Tavily web search
# Get your key at: https://app.tavily.com
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Alternative / fallback LLM providers (optional)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
