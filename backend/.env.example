# =============================================================================
# Helios Terminal — environment variables
#
# Copy this file to .env and fill in your real values.
# .env is excluded from version control (.gitignore). Never commit real keys.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider Configuration
# Set LLM_PROVIDER to "deepseek" or "openrouter" to switch active provider.
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek

# DeepSeek (OpenAI-compatible API) — Primary
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenRouter (OpenAI-compatible API) — Free tier / alternative testing
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model identifier — e.g. "deepseek-chat" or "nvidia/nemotron-3-ultra-550b-a55b:free"
DEFAULT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Retrieval augmentation: Tavily web search
# Get your key at: https://app.tavily.com
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Alternative / fallback LLM providers (optional)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
