# =============================================================================
# Helios Terminal — environment variables
# Copy to .env, fill in real values. .env is gitignored — never commit real keys.
# =============================================================================

# -----------------------------------------------------------------------------
# PROVIDER MODE
# manual -> only LLM_PROVIDER is used, no fallback (old behavior)
# auto   -> LLM_PROVIDER_CHAIN is tried in order; on rate-limit/auth/server
#           error, that provider cools down and the next one in the chain
#           is tried for the SAME call
# -----------------------------------------------------------------------------
LLM_PROVIDER_MODE=auto
LLM_PROVIDER=nvidia_nim
LLM_PROVIDER_CHAIN=nvidia_nim,openrouter,gemini,deepseek_direct
LLM_PROVIDER_COOLDOWN_SEC=60
LLM_PROVIDER_MAX_RETRIES_PER_CALL=4

# -----------------------------------------------------------------------------
# NVIDIA NIM (build.nvidia.com) — free tier, ~40 RPM shared across all models
# Get key at: https://build.nvidia.com/settings/api-keys
# -----------------------------------------------------------------------------
NVIDIA_NIM_API_KEY=nvapi-
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=deepseek-ai/deepseek-v4.1-flash

# -----------------------------------------------------------------------------
# OpenRouter — free tier, use a :free-suffixed model
# Get key at: https://openrouter.ai/keys
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# -----------------------------------------------------------------------------
# Google Gemini (AI Studio, OpenAI-compatible) — free tier is only ~5 RPM
# on gemini-3.5-flash per your own logs. Keep last-but-one in the chain, not first.
# Get key at: https://aistudio.google.com/
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# DeepSeek direct — PAID. Last in chain by design: only touched when every
# free provider above is simultaneously cooling down.
# -----------------------------------------------------------------------------
DEEPSEEK_DIRECT_API_KEY=
DEEPSEEK_DIRECT_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DIRECT_MODEL=deepseek-chat

# -----------------------------------------------------------------------------
# Retrieval augmentation: Tavily web search
# -----------------------------------------------------------------------------
TAVILY_API_KEY=tvly-dev-

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO