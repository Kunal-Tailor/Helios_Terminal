# =============================================================================
# Helios Terminal — environment variables
#
# Copy this file to .env and fill in your real values.
# .env is excluded from version control (.gitignore). Never commit real keys.
# =============================================================================

# ---------------------------------------------------------------------------
# Primary LLM: DeepSeek V4 Flash (via OpenAI-compatible API)
# Get your key at: https://platform.deepseek.com
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# DeepSeek API base URL — change only if using a proxy or a different endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model identifier — pinned to DeepSeek V4 Flash (deepseek-chat).
# Override here if you need to swap models without touching code.
DEFAULT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Retrieval augmentation: Tavily web search
# Get your key at: https://app.tavily.com
# ---------------------------------------------------------------------------
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Alternative / fallback LLM providers (optional)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
